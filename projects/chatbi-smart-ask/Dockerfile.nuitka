FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV SMARTASK_HOST=0.0.0.0
ENV SMARTASK_PORT=8000

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY build/nuitka/run_compiled.dist/ /app/

EXPOSE 8000

CMD ["./chatbi-smart-ask"]
