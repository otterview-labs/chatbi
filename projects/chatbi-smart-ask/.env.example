# LLM 配置模板：复制为 .env 并填入真实 key（.env 已被 gitignore，不会提交）
# 阿里云百炼 DashScope（OpenAI 兼容模式）示例：
SMARTASK_LLM_PROVIDER=openai_compatible
SMARTASK_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMARTASK_OPENAI_API_KEY=CHANGE_ME
SMARTASK_OPENAI_MODEL=qwen-plus

# 也可换任意 OpenAI 兼容服务，如：
# SMARTASK_OPENAI_BASE_URL=https://api.openai.com/v1
# SMARTASK_OPENAI_MODEL=gpt-4o-mini
